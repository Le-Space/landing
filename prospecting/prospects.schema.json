{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-first.le-space.de/schemas/prospect.json",
  "title": "Prospect",
  "description": "Eine Zeile in prospecting/data/prospects.ndjson (NDJSON: ein Objekt pro Zeile).",
  "type": "object",
  "required": ["id", "name", "url", "segment", "status", "updated", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Slug, stabil. Basis für Dossier- und Pitch-Dateinamen."
    },
    "name": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "country": { "type": "string", "description": "ISO-Code, z. B. DE, AT, CH" },
    "city": { "type": "string" },
    "segment": {
      "type": "string",
      "enum": ["software-house", "agency", "brand-it", "peer", "unknown"],
      "description": "S1-S4 aus icp.md; peer = Ökosystem-Partner statt Kunde."
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["security", "fashion", "health", "leisure-tourism", "cross-industry", "other"]
      }
    },
    "size_hint": { "type": "string", "description": "z. B. \"~40 MA (Karriereseite)\" — mit Quelle in Klammern." },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Nur tatsächlich geöffnete Quellen. Keine Behauptung ohne Eintrag hier.",
      "items": {
        "type": "object",
        "required": ["claim", "source_url", "seen"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "seen": { "type": "string", "format": "date" }
        }
      }
    },
    "signals": {
      "type": "object",
      "description": "Rubrik aus scoring.md, je 0-5.",
      "additionalProperties": false,
      "properties": {
        "offline_pain": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "sovereignty_pressure": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "tech_fit": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "rnd_capacity": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "reachability": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "reference_value": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 }
      }
    },
    "score": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 30,
      "description": "offline_pain zaehlt doppelt. null bis der Analyst bewertet hat."
    },
    "tier": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
    "fit_thesis": { "type": "string", "description": "Ein Satz: warum diese Firma, in ihrer Sprache." },
    "prototype_ref": {
      "type": ["string", "null"],
      "enum": ["P1", "P2", "P3", "P4", "P5", "P6", null],
      "description": "ID aus prototypes.md."
    },
    "contacts": {
      "type": "array",
      "description": "Datensparsam: Rolle und oeffentlicher Kanal genuegen. Keine privaten Daten.",
      "items": {
        "type": "object",
        "required": ["role", "source_url"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string" },
          "name": { "type": "string" },
          "public_channel": { "type": "string", "description": "Firmen-Mail, GitHub-Handle, Vortragsseite." },
          "source_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Vermutungen und Wissensluecken. Was hier steht, ist ausdruecklich kein Fakt."
    },
    "status": {
      "type": "string",
      "enum": ["new", "researched", "contacted", "replied", "meeting", "proposal", "won", "lost", "disqualified"]
    },
    "status_reason": { "type": "string", "description": "Pflicht bei lost und disqualified." },
    "next_action": { "type": "string" },
    "next_action_due": { "type": "string", "format": "date" },
    "found_via": { "type": "string", "description": "Kanal-Kuerzel aus queries.md, z. B. \"A-github\", \"D-fosdem\"." },
    "updated": { "type": "string", "format": "date" }
  }
}
